+# X11/Wayland (xkb) keycodes of the letter and digit keys by physical position.
+# Used only when neither the typed character nor Qt's key code names a Latin
+# letter or digit, e.g. with a single non-Latin keyboard layout.
+_XKB_POSITION_KEYS: dict[int, str] = {
+    **{10 + i: c for i, c in enumerate("1234567890")},
+    **{24 + i: c for i, c in enumerate("qwertyuiop")},
+    **{38 + i: c for i, c in enumerate("asdfghjkl")},
+    **{52 + i: c for i, c in enumerate("zxcvbnm")},
+}
+
+
+def binding_key_name(event: QKeyEvent) -> str:
+    """Return the lower-case letter/digit a key event stands for, or ``""``.
+
+    Bindings are stored as Latin letters and digits. With a non-Latin layout
+    active (for example Russian) ``event.text()`` is "ц" rather than "w", and
+    the binding silently stopped working. Prefer the typed character when it is
+    already a Latin letter or digit, then Qt's layout-aware key code, then the
+    physical key position.
+    """
+    text = event.text()
+    if len(text) == 1 and text.isascii() and text.isalnum():
+        return text.lower()
+    key = event.key()
+    if Qt.Key.Key_A <= key <= Qt.Key.Key_Z or Qt.Key.Key_0 <= key <= Qt.Key.Key_9:
+        return chr(key).lower()
+    return _XKB_POSITION_KEYS.get(event.nativeScanCode(), "")
+
+
 class BindingCapture(QPushButton):
     """Capture one supported binding without globally intercepting input."""
 
