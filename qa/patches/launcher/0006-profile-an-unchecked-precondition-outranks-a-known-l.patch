@@ -59,7 +59,14 @@ class Verdict(str, Enum):
 
     @property
     def severity(self) -> int:
-        return {"READY": 0, "UNKNOWN": 1, "PARTIAL": 2, "BLOCKED": 3}[self.value]
+        """READY < PARTIAL < UNKNOWN < BLOCKED.
+
+        UNKNOWN outranks PARTIAL on purpose. With the order the other way
+        round, a host with one known limitation and one precondition nobody
+        could check was reported PARTIAL - "it could run" - and ``profile``
+        exited 0 while ``doctor --strict`` refused the same machine.
+        """
+        return {"READY": 0, "PARTIAL": 1, "UNKNOWN": 2, "BLOCKED": 3}[self.value]
 
 
 @dataclass(frozen=True)
