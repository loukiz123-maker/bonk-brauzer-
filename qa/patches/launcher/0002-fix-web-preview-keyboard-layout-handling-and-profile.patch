+// Bindings are Latin letters and digits. With a non-Latin layout (for example
+// Russian) event.key is "ц" instead of "w" and the binding silently stopped
+// working: prefer the typed character, then fall back to the physical key.
+function bindingKeyName(event) {
+  if (/^[a-z0-9]$/i.test(event.key)) return event.key.toLowerCase();
+  const match = /^(?:Key([A-Z])|Digit([0-9]))$/.exec(event.code || '');
+  return match ? (match[1] || match[2]).toLowerCase() : '';
+}
