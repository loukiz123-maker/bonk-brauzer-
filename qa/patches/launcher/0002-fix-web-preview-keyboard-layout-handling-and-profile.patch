+
+// --- QA regressions ---------------------------------------------------------
+
+test('live test and key capture work with a non-Latin keyboard layout', async () => {
+  const {context, pages: [page]} = await freshPages();
+  try {
+    await page.click('#open-controls'); await waitForProfile(page);
+    // Russian layout: the physical F key types "а".
+    await page.click('#capture-key');
+    await page.locator('#capture-key').evaluate(el => el.dispatchEvent(new KeyboardEvent('keydown', {key:'а', code:'KeyF', bubbles:true, cancelable:true})));
+    assert.equal(await page.locator('#control-key').inputValue(), 'F');
+    await page.selectOption('#control-kind', {label: 'Огонь'});
+    await page.locator('#control-key').fill('F');
+    await addMarker(page);
+    await page.click('#live-test');
+    const send = (type, key, code) => page.locator('#canvas').evaluate((el, e) => el.dispatchEvent(new KeyboardEvent(e.type, {key: e.key, code: e.code, bubbles: true, cancelable: true})), {type, key, code});
+    await send('keydown', 'а', 'KeyF');
+    assert.equal(await page.locator('#canvas .marker.active').count(), 1);
+    assert.match(await page.locator('#editor-status').textContent(), /удерживается: 1/);
+    await send('keyup', 'а', 'KeyF');
+    assert.equal(await page.locator('#canvas .marker.active').count(), 0);
+    // A Latin layout that moves letters (AZERTY) keeps the typed character:
+    // the key in the F position types "q" there and must not trigger F...
+    await send('keydown', 'q', 'KeyF');
+    assert.equal(await page.locator('#canvas .marker.active').count(), 0);
+    await send('keyup', 'q', 'KeyF');
+    // ...while a typed "f" does, wherever the key physically is.
+    await send('keydown', 'f', 'KeyU');
+    assert.equal(await page.locator('#canvas .marker.active').count(), 1);
+    await send('keyup', 'f', 'KeyU');
+    // Keys that are neither letters nor digits are still ignored.
+    await send('keydown', ' ', 'Space');
+    assert.equal(await page.locator('#canvas .marker.active').count(), 0);
+  } finally { await context.close(); }
+});
+
+test('layout import is refused while a profile is still loading or saving', async () => {
+  const {context, pages: [page]} = await freshPages();
+  try {
+    await page.click('#open-controls'); await waitForProfile(page);
+    await page.evaluate(() => setProfileBusy(true));
+    const draft = {schema: 1, controls: [{kind: 'Огонь', key: 'F', x: 0.5, y: 0.5}]};
+    await page.locator('#import-file').setInputFiles({name: 'layout.json', mimeType: 'application/json', buffer: Buffer.from(JSON.stringify(draft))});
+    await page.waitForSelector('#message:text("Подождите завершения работы с раскладкой")');
+    assert.equal(await page.locator('#canvas .marker').count(), 0);
+    await page.evaluate(() => setProfileBusy(false));
+    await page.locator('#import-file').setInputFiles({name: 'layout.json', mimeType: 'application/json', buffer: Buffer.from(JSON.stringify(draft))});
+    await page.waitForSelector('#editor-status:text("Раскладка импортирована")');
+    assert.equal(await page.locator('#canvas .marker').count(), 1);
+  } finally { await context.close(); }
+});
