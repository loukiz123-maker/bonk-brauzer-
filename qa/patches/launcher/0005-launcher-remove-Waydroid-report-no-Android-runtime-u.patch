diff --git a/tests/test_no_waydroid.py b/tests/test_no_waydroid.py
new file mode 100644
index 0000000..acacd0e
--- /dev/null
+++ b/tests/test_no_waydroid.py
@@ -0,0 +1,76 @@
+"""Waydroid was removed on the project owner's decision; it stays removed.
+
+The decision (2026-11-10) was that neither the engine nor the launcher may
+depend on Waydroid, and that the Android runtime is to be a
+hardware-accelerated virtual machine. A dependency like this comes back one
+convenient import at a time, so the tree is searched rather than trusted.
+
+One mention is allowed: ``settings.py`` recognises the old value
+``backend = "waydroid"`` so that an existing settings file is migrated with a
+warning instead of being rejected.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SRC = ROOT / "src" / "lynxdroid"
+
+#: The only source file allowed to contain the word, and how often.
+ALLOWED = {SRC / "settings.py": 2}
+
+_WORD = re.compile(r"waydroid", re.IGNORECASE)
+
+
+def _hits(path: Path) -> list[str]:
+    text = path.read_text(encoding="utf-8", errors="replace")
+    return [
+        f"{path.relative_to(ROOT)}:{number}: {line.strip()}"
+        for number, line in enumerate(text.splitlines(), start=1)
+        if _WORD.search(line)
+    ]
+
+
+def test_no_source_file_mentions_waydroid() -> None:
+    offenders: list[str] = []
+    for path in sorted(SRC.rglob("*.py")):
+        hits = _hits(path)
+        if len(hits) > ALLOWED.get(path, 0):
+            offenders.extend(hits)
+    assert not offenders, "Waydroid is back in the source tree:\n" + "\n".join(offenders)
+
+
+def test_the_allowed_mention_is_the_settings_migration() -> None:
+    hits = _hits(SRC / "settings.py")
+    assert hits, "the migration of the old 'waydroid' value is gone; update ALLOWED"
+    assert all("backend" in hit for hit in hits)
+
+
+def test_the_removed_modules_do_not_exist() -> None:
+    for name in ("waydroid.py", "images.py"):
+        assert not (SRC / "backend" / name).exists(), name
+
+
+def test_nothing_executes_a_waydroid_binary() -> None:
+    """Scripts, packaging and the web preview included - not only Python."""
+    offenders: list[str] = []
+    for directory in ("scripts", "packaging", "runtime", "android_agent", "web-preview"):
+        base = ROOT / directory
+        if not base.is_dir():
+            continue
+        for path in sorted(base.rglob("*")):
+            if path.is_file() and path.suffix not in {".png", ".jpg", ".jpeg", ".ico", ".jar"}:
+                offenders.extend(_hits(path))
+    assert not offenders, "\n".join(offenders)
+
+
+def test_packaging_does_not_depend_on_waydroid() -> None:
+    assert not _hits(ROOT / "pyproject.toml")
+
+
+def test_ci_does_not_install_or_call_waydroid() -> None:
+    workflows = ROOT / ".github" / "workflows"
+    offenders = [hit for path in sorted(workflows.glob("*.yml")) for hit in _hits(path)]
+    assert not offenders, "\n".join(offenders)
