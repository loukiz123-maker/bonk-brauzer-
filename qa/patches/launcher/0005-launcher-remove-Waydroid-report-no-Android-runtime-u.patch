-    def install_apk(self, path: str) -> tuple[bool, str]:
-        apk = Path(path)
-        if apk.suffix.lower() != ".apk":
-            return False, "only .apk files can be installed (split APK/AAB unsupported)"
-        if not apk.is_file():
-            return False, f"{apk} is not a file"
-        if apk.is_symlink():
