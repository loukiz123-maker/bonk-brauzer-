+++ b/src/lynxdroid/backend/none.py
@@ -0,0 +1,131 @@
+"""The backend used when no Android runtime exists in this build.
+
+LynxDroid used to drive an external Android container. That adapter was
+removed on the project owner's decision of 2026-11-10, and the chosen
+direction is a hardware-accelerated virtual machine
+(``docs/STANDALONE_VM_RU.md``). That runtime is not implemented yet.
+
+Until it is, every command that needs Android gets this object. It answers the
+contract truthfully: nothing is supported, nothing is running, and every action
+fails with one explanation instead of pretending to try.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+from lynxdroid.backend.contract import (
+    AndroidBackend,
+    BackendCapabilities,
+    BackendError,
+    BackendState,
+    Consent,
+    Feature,
+    Snapshot,
+    Support,
+)
+from lynxdroid.core.diagnostics import Report
+from lynxdroid.core.errors import ExitCode
+from lynxdroid.doctor import checks as doctor_checks
+
+NO_RUNTIME_REASON = (
+    "this build has no Android runtime; the virtual-machine runtime is not implemented yet"
+)
+NO_RUNTIME_HINT = (
+    "see docs/STANDALONE_VM_RU.md; 'lynxdroid doctor' reports whether this host has KVM"
+)
+
+_FEATURES: tuple[tuple[str, str], ...] = (
+    ("session", "Android session"),
+    ("app-list", "App list"),
+    ("app-launch", "App launch"),
+    ("apk-install", "APK install"),
+    ("display", "Display configuration"),
+    ("shell", "Android shell"),
+)
+
+
+class NoRuntimeError(BackendError):
+    """An Android action was requested and there is no runtime to perform it."""
+
+    def __init__(self, action: str) -> None:
+        super().__init__(
+            f"cannot {action}: {NO_RUNTIME_REASON}", code="no-runtime", hint=NO_RUNTIME_HINT
+        )
+        self.exit_code = ExitCode.UNSUPPORTED
+
+
+class NoBackend(AndroidBackend):
+    """Reports that Android cannot be started; changes nothing anywhere."""
+
+    @property
+    def name(self) -> str:
+        return "none"
+
+    def capabilities(self) -> BackendCapabilities:
+        return BackendCapabilities(
+            name="none",
+            version="-",
+            features=tuple(
+                Feature(key, title, Support.UNSUPPORTED, NO_RUNTIME_REASON)
+                for key, title in _FEATURES
+            ),
+            max_touches=0,
+            notes=(NO_RUNTIME_REASON,),
+        )
+
+    def diagnose(self) -> Report:
+        return doctor_checks.environment_report()
+
+    def snapshot(self) -> Snapshot:
+        return Snapshot(state=BackendState.NOT_CONFIGURED, readiness={}, detail=NO_RUNTIME_REASON)
+
+    def start(self, *, timeout_s: float = 90.0) -> Snapshot:
+        raise NoRuntimeError("start Android")
+
+    def stop(self, *, timeout_s: float = 45.0) -> Snapshot:
+        """Nothing was started, so there is nothing to stop; that is not an error."""
+        return self.snapshot()
+
+    def apply_display(
+        self, width: int, height: int, dpi: int, *, consent: Consent | None = None
+    ) -> list[str]:
+        raise NoRuntimeError("change the Android display")
+
+    def read_display(self) -> dict[str, str]:
+        raise NoRuntimeError("read the Android display")
+
+    def list_apps(self) -> list[dict[str, str]]:
+        """Raises rather than returning ``[]``: "no apps" would be a claim about Android."""
+        raise NoRuntimeError("list Android apps")
+
+    def launch_app(self, package: str) -> bool:
+        raise NoRuntimeError(f"launch {package}")
+
+    def install_apk(self, path: str) -> tuple[bool, str]:
+        raise NoRuntimeError("install an APK")
+
+    def get_prop(self, name: str) -> str | None:
+        return None
+
+    def set_prop(self, name: str, value: str, *, consent: Consent | None = None) -> bool:
+        raise NoRuntimeError("write an Android property")
+
+    def shell_probe(self, command: Sequence[str], *, timeout: float = 10.0) -> tuple[int, str]:
+        raise NoRuntimeError("run a command inside Android")
+
+    def show_full_ui(self) -> bool:
+        raise NoRuntimeError("show the Android window")
+
+
+#: Every value ``Settings.backend`` and ``--backend`` accept.
+BACKEND_KINDS: tuple[str, ...] = ("none", "fake")
+
+
+def create_backend(kind: str) -> AndroidBackend:
+    """The backend for ``kind``; anything unknown is "no runtime", never a guess."""
+    if kind == "fake":
+        from lynxdroid.backend.fake import FakeBackend
+
+        return FakeBackend()
+    return NoBackend()
