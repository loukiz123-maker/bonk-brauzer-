+"""Settings written by an older build still load after Waydroid was removed.
+
+An upgrade must not turn a working settings file into a traceback, and it must
+not silently keep a backend that no longer exists.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from lynxdroid.core.paths import AppPaths
+from lynxdroid.settings import Settings, SettingsStore
+
+
+def _store(tmp_path: Path) -> tuple[SettingsStore, AppPaths]:
+    paths = AppPaths.resolve(tmp_path / "xdg")
+    paths.ensure()
+    return SettingsStore(paths), paths
+
+
+class TestBackendSetting:
+    def test_the_default_backend_is_none(self) -> None:
+        assert Settings().backend == "none"
+
+    def test_waydroid_becomes_none_with_a_warning(self) -> None:
+        settings, warnings = Settings(backend="waydroid").clamped()
+        assert settings.backend == "none"
+        assert any("removed" in w and "waydroid" in w for w in warnings)
+
+    def test_an_unknown_backend_becomes_none(self) -> None:
+        settings, warnings = Settings(backend="virtualbox").clamped()
+        assert settings.backend == "none"
+        assert any("unknown" in w for w in warnings)
+
+    def test_fake_is_kept(self) -> None:
+        settings, warnings = Settings(backend="fake").clamped()
+        assert settings.backend == "fake"
+        assert not warnings
+
+
+class TestOldSettingsFile:
+    def test_a_file_from_the_waydroid_era_loads(self, tmp_path: Path) -> None:
+        store, paths = _store(tmp_path)
+        paths.settings_file.write_text(
+            json.dumps(
+                {
+                    "schema": 1,
+                    "backend": "waydroid",
+                    "allow_service_control": True,
+                    "allow_prop_writes": True,
+                    "dpi": 240,
+                }
+            ),
+            encoding="utf-8",
+        )
+        settings, notes = store.load()
+        assert settings.backend == "none"
+        assert settings.dpi == 240, "unrelated values must survive the upgrade"
+        text = " ".join(notes)
+        assert "waydroid" in text and "removed" in text
+
+    def test_the_removed_permission_switches_are_reported_not_obeyed(self, tmp_path: Path) -> None:
+        store, paths = _store(tmp_path)
+        paths.settings_file.write_text(
+            json.dumps({"schema": 1, "allow_service_control": True, "allow_prop_writes": True}),
+            encoding="utf-8",
+        )
+        settings, notes = store.load()
+        assert not hasattr(settings, "allow_service_control")
+        assert not hasattr(settings, "allow_prop_writes")
+        text = " ".join(notes)
+        assert "allow_service_control" in text and "allow_prop_writes" in text
+
+    def test_the_removed_switches_are_not_fields_any_more(self) -> None:
+        fields = set(Settings.__dataclass_fields__)
+        assert not {"allow_service_control", "allow_prop_writes"} & fields
