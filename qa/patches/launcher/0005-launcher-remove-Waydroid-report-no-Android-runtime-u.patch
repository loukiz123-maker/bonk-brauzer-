new file mode 100644
index 0000000..af5bd64
--- /dev/null
+++ b/tests/backend/test_no_runtime.py
@@ -0,0 +1,122 @@
+"""The backend a build without an Android runtime hands to every command.
+
+Waydroid was removed on the project owner's decision and the virtual machine
+that replaces it is not written. In between, the dangerous failure is not a
+crash - it is a command that looks as if it worked. These tests pin the
+opposite: nothing is supported, nothing runs, every action says why, and
+nothing on the host is touched.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from lynxdroid.backend import none as none_backend
+from lynxdroid.backend.contract import BackendError, BackendState, Support, user_consented
+from lynxdroid.backend.fake import FakeBackend
+from lynxdroid.backend.none import NoBackend, NoRuntimeError, create_backend
+from lynxdroid.core import proc
+from lynxdroid.core.errors import ExitCode, LynxError
+
+
+class TestTheFactory:
+    def test_the_default_kind_is_no_runtime(self) -> None:
+        assert isinstance(create_backend("none"), NoBackend)
+
+    def test_the_fake_backend_is_only_given_when_asked_for(self) -> None:
+        assert isinstance(create_backend("fake"), FakeBackend)
+
+    @pytest.mark.parametrize("kind", ["waydroid", "", "qemu", "virtualbox", "FAKE"])
+    def test_an_unknown_kind_is_no_runtime_never_a_guess(self, kind: str) -> None:
+        assert isinstance(create_backend(kind), NoBackend)
+
+    def test_the_accepted_kinds_do_not_include_waydroid(self) -> None:
+        assert none_backend.BACKEND_KINDS == ("none", "fake")
+
+
+class TestItClaimsNothing:
+    def test_every_feature_is_unsupported_with_a_reason(self) -> None:
+        capabilities = NoBackend().capabilities()
+        assert capabilities.features, "an empty list would read as 'nothing to report'"
+        for feature in capabilities.features:
+            assert feature.support is Support.UNSUPPORTED, feature.key
+            assert "no Android runtime" in feature.reason
+
+    def test_no_touch_points_are_promised(self) -> None:
+        assert NoBackend().capabilities().max_touches == 0
+
+    def test_the_state_is_not_configured_not_stopped(self) -> None:
+        """STOPPED would imply there is something that could be started."""
+        snapshot = NoBackend().snapshot()
+        assert snapshot.state is BackendState.NOT_CONFIGURED
+        assert "no Android runtime" in snapshot.detail
+
